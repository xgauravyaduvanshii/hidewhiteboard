{
  "compilerOptions": {
    "rootDir": "./",
    "target": "ESNext",
    "lib": ["dom", "dom.iterable", "esnext"],
    "types": ["vitest/globals", "@testing-library/jest-dom"],
    "allowJs": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "noFallthroughCasesInSwitch": true,
    "module": "ESNext",
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": {
      "@hidewhiteboard/common": ["./packages/common/src/index.ts"],
      "@hidewhiteboard/common/*": ["./packages/common/src/*"],
      "@hidewhiteboard/hidewhiteboard": ["./packages/hidewhiteboard/index.tsx"],
      "@hidewhiteboard/hidewhiteboard/*": ["./packages/hidewhiteboard/*"],
      "@hidewhiteboard/element": ["./packages/element/src/index.ts"],
      "@hidewhiteboard/element/*": ["./packages/element/src/*"],
      "@hidewhiteboard/math": ["./packages/math/src/index.ts"],
      "@hidewhiteboard/math/*": ["./packages/math/src/*"],
      "@hidewhiteboard/utils": ["./packages/utils/src/index.ts"],
      "@hidewhiteboard/utils/*": ["./packages/utils/src/*"]
    }
  },
  "include": ["packages", "hidewhiteboard-app"],
  "exclude": ["examples", "dist", "types", "tests"]
}
